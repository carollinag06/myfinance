{
  "expo": {
    "name": "MyFinance",
    "slug": "myfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myfinance",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o MyFinance acesse suas fotos para usar uma imagem no perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.myfinance.finapp"
    },
    "ios": {
      "bundleIdentifier": "com.myfinance.finapp",
      "supportsTablet": true
    }
  }
}
